# Copy to .env. scripts/fabric-up.sh fills empty secrets with random values.
# Do not commit .env.

NODE_ENV=development
APP_PORT=4000
PUBLIC_APP_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:8080
SESSION_SECRET=
SESSION_TTL_HOURS=12

POSTGRES_USER=praman
POSTGRES_PASSWORD=
POSTGRES_DB=praman
DATABASE_URL=

ADMIN_EMAIL=admin@praman.local
ADMIN_NAME="Platform Administrator"
ADMIN_PASSWORD=

UPLOAD_DIR=/data/certificates
WALLET_DIR=/data/wallets
MAX_UPLOAD_BYTES=5242880

# Fabric gateway. Paths are valid inside the backend container.
FABRIC_PEER_ENDPOINT=peer0.platform.certnet.local:7051
FABRIC_PEER_HOST_ALIAS=peer0.platform.certnet.local
FABRIC_CHANNEL=certchannel
FABRIC_CHAINCODE=certregistry
FABRIC_PLATFORM_MSP=PlatformMSP
FABRIC_ISSUER_MSP=IssuerMSP
FABRIC_TLS_CERT_PATH=/fabric/organizations/gateway-tls-ca.pem
FABRIC_PLATFORM_CERT_PATH=/fabric/organizations/peerOrganizations/platform.certnet.local/users/Admin@platform.certnet.local/msp/signcerts/cert.pem
FABRIC_PLATFORM_KEY_PATH=/fabric/organizations/peerOrganizations/platform.certnet.local/users/Admin@platform.certnet.local/msp/keystore/key.pem
FABRIC_VERIFIER_CERT_PATH=/fabric/organizations/peerOrganizations/platform.certnet.local/users/Verifier@platform.certnet.local/msp/signcerts/cert.pem
FABRIC_VERIFIER_KEY_PATH=/fabric/organizations/peerOrganizations/platform.certnet.local/users/Verifier@platform.certnet.local/msp/keystore/key.pem
FABRIC_CA_URL=https://ca.issuers.certnet.local:8054
FABRIC_CA_NAME=ca-issuers
# Leaf presented by the CA. The API also trusts ca-cert.pem in this directory.
FABRIC_CA_TLS_CERT_PATH=/fabric/organizations/fabric-ca/issuers/tls-cert.pem
FABRIC_CA_REGISTRAR_CERT_PATH=/fabric/organizations/fabric-ca/issuers/registrar/cert.pem
FABRIC_CA_REGISTRAR_KEY_PATH=/fabric/organizations/fabric-ca/issuers/registrar/key.pem

# Fabric CA bootstrap identities. Usernames stay stable. Passwords are generated.
CA_PLATFORM_ADMIN_USER=admin
CA_PLATFORM_ADMIN_PASSWORD=
CA_ISSUER_ADMIN_USER=admin
CA_ISSUER_ADMIN_PASSWORD=
CA_ORDERER_ADMIN_USER=admin
CA_ORDERER_ADMIN_PASSWORD=

# Optional demo seed. Leave empty to skip demo institutions.
DEMO_PASSWORD=
